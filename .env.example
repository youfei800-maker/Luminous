# Copy to .env.local on your own Mac. Never commit real keys.
LUMINOUS_STORAGE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
SUPABASE_STORAGE_BUCKET=luminous-media
# The Vercel integration may set NEXT_PUBLIC_SUPABASE_URL instead of SUPABASE_URL.
# SUPABASE_SECRET_KEY (sb_secret_...) is also accepted as the server-only key.
